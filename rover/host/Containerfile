# FSK rover host bootc image — AlmaLinux 10 + Raspberry Pi 5 firmware/DTB
# (bcm2712-rpi-5-b.dtb, kernel_2712.img, /boot/efi assets) + the runtime
# pieces every rover needs: NetworkManager, sshd, tailscale, podman,
# udev rules, and the pilot.service + pilot-run launcher.
#
# The pilot ROS workload is NOT in this image. It is a separate OCI
# image (ghcr.io/luftaquila/fsk-rover-pilot) pulled at runtime by
# pilot.service, which invokes /usr/local/bin/pilot-run to probe /dev
# and `podman run` the pilot container. Lifecycles are decoupled: bootc
# upgrades roll the host (rare, requires reboot); podman-auto-update
# rolls the pilot container (frequent, in place).
#
# Built by .github/workflows/rover-host-image.yml and pushed to
# ghcr.io/luftaquila/fsk-rover-host:{candidate,edge,vX.Y.Z}.
# Flashable SD images are produced from this base by
# .github/workflows/rover-sd-image.yml using AlmaLinux's
# bootc-images-rpi tooling (which knows about Pi 5's GPT/FAT
# firmware partition layout).

FROM quay.io/almalinuxorg/almalinux-bootc-rpi:10

# Tailscale's RHEL repo is not part of AlmaLinux's defaults.
RUN dnf install -y dnf-plugins-core \
    && dnf config-manager --add-repo https://pkgs.tailscale.com/stable/rhel/10/tailscale.repo

# Runtime stack. NetworkManager-wifi + wpa_supplicant are pulled in
# explicitly because the bootc-rpi base ships only the wired-only NM
# core; without them NM marks wlan0 'unmanaged' and the baked
# fsk-default Wi-Fi profile can't activate.
RUN dnf install -y \
        NetworkManager \
        NetworkManager-wifi \
        wpa_supplicant \
        openssh-server \
        podman \
        tailscale \
        policycoreutils-python-utils \
    && dnf clean all

# Operator account. Declared via sysusers.d, not a Containerfile-time
# edit of /etc/passwd. authorized_keys is a build-time snapshot of
# https://github.com/luftaquila.keys; rotate by rebuilding this image.
#
# OSTree's three-way merge for /etc preserves user modifications across
# bootc deploys: cloud-init (or anyone) writing to /etc/passwd on the
# previous deployment shadows our new /etc/passwd entries from the
# image. systemd-sysusers runs every boot and adds missing users to
# /etc/passwd in-place; that's the bootc-native way to declare a user.
#
# Keys must live at /var/home/fsk/.ssh/authorized_keys, not in /etc.
# SELinux file_contexts puts ~/.ssh/* in the ssh_home_t domain, which
# sshd_t is allowed to open for authorized-keys lookup; files in
# /etc/ssh/authorized_keys.d/* end up etc_t and sshd_t cannot open
# them for that purpose (sshd logs "Permission denied" on the file).
#
# bootc deploys initialize /var fresh from /usr/share/factory/var, so
# we bake the home tree there and let tmpfiles.d/fsk-home.conf seed
# /var/home/fsk on first boot.
#
# fsk is NOT in `wheel`; sudoers.d/fsk whitelists only the commands
# provision-rover.sh needs.
RUN install -d -m 700 -o 1500 -g 1500 /usr/share/factory/var/home/fsk \
                                      /usr/share/factory/var/home/fsk/.ssh \
    && curl -fsSL https://github.com/luftaquila.keys \
         -o /usr/share/factory/var/home/fsk/.ssh/authorized_keys \
    && chmod 600 /usr/share/factory/var/home/fsk/.ssh/authorized_keys \
    && chown 1500:1500 /usr/share/factory/var/home/fsk/.ssh/authorized_keys

# Narrow sudo grant — only the commands provision-rover.sh and operators
# actually need. Avoids handing fsk full root.
RUN install -d -m 750 /etc/sudoers.d \
    && printf 'Defaults secure_path="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin"\nfsk ALL=(ALL) NOPASSWD: /usr/bin/podman, /usr/bin/systemctl, /usr/bin/install, /usr/bin/tee, /usr/bin/nmcli, /usr/bin/tailscale, /usr/bin/bootc, /usr/local/bin/flash-mcu\n' \
         > /etc/sudoers.d/fsk \
    && chmod 440 /etc/sudoers.d/fsk

# firewalld off: this is a single-purpose rover with --network=host ROS 2.
# FastDDS uses dynamic ports starting at 7400 + 250*ROS_DOMAIN_ID and
# multicast 239.255.0.0/24; running zone-based filtering on top adds
# operational surface for no security gain on this device.
RUN systemctl disable firewalld 2>/dev/null || true

# Static assets — pilot.service, pilot-run wrapper, env example, NM
# profile, tmpfiles.d, sysusers.d, udev rules, hostname.
COPY files/ /

# NM connection files must be 0600 or NetworkManager refuses to load them.
# pilot-run / flash-mcu / pid-tune need +x to be exec'd by their respective
# units (pilot-run, flash-mcu) or the operator (pid-tune).
RUN chmod 600 /etc/NetworkManager/system-connections/fsk-default.nmconnection \
    && chmod 755 /usr/local/bin/flash-mcu /usr/local/bin/pilot-run /usr/local/bin/pid-tune \
                 /usr/local/bin/perception-run

# SELinux: container_use_devices boolean must be enabled for the pilot
# container's --device /dev/* mappings to work under enforcing mode.
# Set at boot by fsk-selinux-booleans.service (not at image build time —
# buildkit's environment lacks the policy DB and `setsebool` would fail).

# OTA: bootc pulls the host image, podman-auto-update pulls the pilot +
# perception containers. pilot.service / perception.service are hand-written
# (see files/usr/lib/systemd/system/) rather than quadlets — their run wrappers
# probe /dev at start so missing USB devices don't block the whole container,
# which a static AddDevice= would.
RUN systemctl enable \
        NetworkManager \
        sshd \
        tailscaled \
        podman.socket \
        bootc-fetch-apply-updates.timer \
        podman-auto-update.timer \
        fsk-selinux-booleans.service \
        pilot.service \
        perception.service
