[connection]
id=fsk-default
type=wifi
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid=default
# Belt-and-suspenders with the 50-wifi-powersave-off NM dispatcher: keep the
# headless rover reachable when idle. This driver ignores the setting (hence the
# dispatcher), but set it too so intent is explicit for drivers that honor it.
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=password

[ipv4]
method=auto

[ipv6]
method=ignore
