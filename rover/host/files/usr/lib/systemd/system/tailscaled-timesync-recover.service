[Unit]
Description=Restart tailscaled after the clock syncs (RTC-less cold boot self-heal)
# The Pi 5 RTC has no backup cell here, so a battery-switch cold boot starts
# with a wrong clock. tailscaled then fails its control-server TLS ("cert not
# yet valid") and does not recover until a reboot. Wait for NTP to step the
# clock, then bounce tailscaled once so it re-handshakes with a correct time.
# (A power-button reboot keeps the 5V rail alive, so the RTC survives and the
# problem doesn't show — this covers the full-cold-boot case. Fitting the Pi 5
# RTC coin cell removes the need for this entirely.)
After=chronyd.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 1 90); do [ "$(timedatectl show -p NTPSynchronized --value)" = yes ] && break; sleep 1; done; systemctl restart tailscaled'

[Install]
WantedBy=multi-user.target
