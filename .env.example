# Domain name for traefik reverse proxy (production only)
# Leave empty or remove for local development
DOMAIN_NAME=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=

# JWT & Security
JWT_SECRET=
INTERNAL_SECRET=
ADMIN_EMAIL=

# Test server mode
# - Backend: auto-register all Google logins as admin
# - Frontend: show ⚠️ TEST prefix on all page titles and favicon
# TEST_SERVER=true

# VWorld API key for the course map basemap (https://www.vworld.kr → 오픈API → 인증키)
# When set, the course map uses VWorld satellite tiles (georeferenced to the
# Korean national datum); when empty it falls back to Google satellite tiles.
# The serving domain (e.g. test.luftaquila.io, localhost) must be registered on
# the key or VWorld rejects the tile requests.
# VWORLD_KEY=

# Log/telemetry retention caps (optional; sensible defaults applied when unset).
# Each service keeps only the newest N rows for high-growth tables.
# EMAIL_LOG_MAX_ROWS=50000          # email service: email_log rows (default 50000)
# MISSION_TELEMETRY_MAX_ROWS=500000 # course service: mission_telemetry rows (default 500000)

# Rover path validation limits (optional, course service).
# ROVER_MAX_WAYPOINT_DIST_M=200 # max distance (m) from rover to the first waypoint (default 200)
# ROVER_MAX_SEGMENT_DIST_M=50   # max distance (m) between consecutive waypoints (default 50)

# Rover-scoped secret (optional). When set, the rover/perception/GPS field devices
# authenticate to the course rover routes (and WHIP publish) with X-Rover-Secret =
# this value instead of the hub-wide INTERNAL_SECRET, so a stolen field device leaks
# only a course-rover-scoped credential. Provision the devices (scripts/provision-*.sh),
# verify on hardware, then INTERNAL_SECRET can be dropped from the devices. Unset =
# devices keep using INTERNAL_SECRET (backward compatible).
# ROVER_SECRET=

# NTRIP (RTK correction) account username for gnssdata.or.kr, baked into the rover
# and GPS units at provisioning time. scripts/provision-rover.sh / provision-gps.sh
# read this when --ntrip-username is not passed. No hardcoded default — set here or
# pass the flag, otherwise provisioning aborts.
# NTRIP_USERNAME=
