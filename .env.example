# Domain name for traefik reverse proxy (production only)
# Leave empty or remove for local development
DOMAIN_NAME=

# Site identity and features. Leave a value empty for the Formula Student Korea
# default (shared/common/site-config.js); a set but invalid value stops startup.
# - SITE_NAME: full name (landing page, Open Graph, email body)
# - SITE_SHORT_NAME: prefix for page titles, email subjects, SMS, and file names
# - PUBLIC_URL: public origin used in emailed links and the OAuth callback
#   (without it, OAuth uses the request host)
# - FEATURES: comma-separated features to enable; default is every feature.
#     Dependencies: registration, queue, documents need entry and email;
#     inspection and traffic need entry; score needs entry, inspection, traffic.
#     All: entry,registration,queue,inspection,traffic,score,documents,course,calendar,files,energymeter,email
# - SITE_LINKS: JSON array of menu links, [] for none; default is the FSK links
#     [{"name": "...", "href": "https://...", "icon": "energy"}]
#     icon is a key of shared/common/nav-icons.js; links starting with "/" stay in-tab.
# - SITE_OG_IMAGE: absolute http(s) URL of the link-preview image; default is the
#     packaged /og-image.png
SITE_NAME=
SITE_SHORT_NAME=
PUBLIC_URL=
FEATURES=
SITE_LINKS=
SITE_OG_IMAGE=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT & Security
JWT_SECRET=
INTERNAL_SECRET=
ADMIN_EMAIL=

# Test server mode
# - Backend: auto-register all Google logins as admin
# - Frontend: show a TEST prefix on all page titles and a ⚠️ favicon
# TEST_SERVER=true

# VWorld API key for the course map basemap (https://www.vworld.kr → 오픈API → 인증키)
# When set, the course map uses VWorld satellite tiles (georeferenced to the
# Korean national datum); when empty it falls back to Google satellite tiles.
# The serving domain (e.g. test.luftaquila.io, localhost) must be registered on
# the key or VWorld rejects the tile requests.
# VWORLD_KEY=

# Log retention caps (optional; sensible defaults applied when unset).
# Each service keeps only the newest N rows for high-growth tables.
# EMAIL_LOG_MAX_ROWS=50000          # email service: email_log rows (default 50000)

# Rover and GPS unit API addresses offered to rover operators in the course
# console (fsk-coursekeeper devices on the tailnet). JSON array of
# { "id", "kind": "rover"|"gps", "label", "url": "https://….ts.net" }.
# COURSE_DEVICES=[{"id":"rover","kind":"rover","label":"Rover","url":"https://fsk-coursekeeper-rover.your-tailnet.ts.net"}]
