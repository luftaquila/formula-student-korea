# Domain name for traefik reverse proxy (production only)
# Leave empty or remove for local development
DOMAIN_NAME=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=

# JWT & Security
JWT_SECRET=
INTERNAL_SECRET=
ADMIN_EMAIL=

# Test server mode (auto-register all Google logins as admin)
# TEST_SERVER=true

# Google Calendar API (calendar service)
# Calendar ID: Google Calendar → 설정 → 캘린더 통합 → 캘린더 ID
GOOGLE_CALENDAR_ID=
# Service account key: calendar/credentials.json 파일로 마운트됨 (compose.yml 참조)
# 해당 캘린더를 서비스 계정 이메일에 편집자 권한으로 공유 필요

# Naver Cloud SMS API (queue service)
NAVER_CLOUD_ACCESS_KEY=
NAVER_CLOUD_SECRET_KEY=
NAVER_CLOUD_SMS_SERVICE_ID=
PHONE_NUMBER_SMS_SENDER=
