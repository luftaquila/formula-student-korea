{
	# Production terminates TLS at traefik, which forwards the real client IP in
	# X-Forwarded-For. Trust that hop so per-IP rate limits (auth login, queue
	# state) and audit logs see the real client instead of the traefik container
	# IP — otherwise every external user shares one rate-limit bucket (a trivial
	# unauthenticated login-lockout DoS). caddy is only reachable via traefik in
	# production (no host port), so trusting private ranges = trusting traefik.
	servers {
		trusted_proxies static private_ranges
	}
}

:9000 {
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/wasm
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self'; font-src 'self' https://fonts.gstatic.com data:; object-src 'none'; frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	# 심층방어: trusted_proxies로 해석한 실제 클라이언트 IP를 X-Real-IP로 세팅하고 인바운드 값을
	# 덮어쓴다(클라이언트가 직접 보낸 X-Real-IP는 무시). 백엔드는 이 단일 헤더를 rate-limit·감사로그의
	# client IP로 읽어, 위조하기 쉬운 X-Forwarded-For 최좌측 대신 신뢰 IP를 쓴다(프로덕션 traefik→caddy
	# 에선 실제 외부 클라이언트로, dev caddy-local에선 접속 IP로 해석).
	request_header X-Real-IP {client_ip}

	# Auth service
	redir /auth /auth/
	handle_path /auth/* {
		request_header -X-Internal-Service
		request_header -Authuser
		request_header -X-Forwarded-Host
		reverse_proxy auth:9100 {
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	# Competition modular monolith. UI prefixes stay stable while all API/SSE
	# traffic uses the explicit versioned namespace.
	handle /competition/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Entry UI
	redir /entry /entry/
	handle /entry/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Queue UI
	redir /queue /queue/
	handle /queue/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Registration queue UI
	redir /registration /registration/
	handle /registration/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Inspection UI
	redir /inspection /inspection/
	handle /inspection/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Traffic UI
	redir /traffic /traffic/
	handle /traffic/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Course service (map tiles require relaxed CSP)
	redir /course /course/
	handle_path /course/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://*.googleusercontent.com https://mt0.google.com https://mt1.google.com https://mt2.google.com https://mt3.google.com https://api.vworld.kr; connect-src 'self'; font-src 'self' https://fonts.gstatic.com data:; object-src 'none'; frame-ancestors 'self'"

		# Rover-side SSE/REST endpoints authenticate via X-Internal-Service.
		# The rover sits on the open internet (no Tailscale) so on these
		# paths we skip the header-strip that the rest of /course/* gets.
		# Authuser and X-Forwarded-For are still stripped to keep admin
		# identity and IP-trust scoped to internal traffic.
		@rover path /api/rover/*
		handle @rover {
			request_header -Authuser
			request_header -X-Forwarded-For
			reverse_proxy course:10000
		}

		# WebRTC signaling (WHIP publish / WHEP play) → mediamtx. Media (SRTP) does
		# NOT pass here — it's UDP direct to mediamtx (router-forwarded 8189). Only
		# the HTTP offer/answer rides 443 → same-origin, so CSP connect-src 'self'
		# covers the browser side.
		#
		# mediamtx is permit-all + ClusterIP-only, so these gates ARE the access
		# control (without a signaling exchange the SRTP keys can't be set up, so
		# the media UDP port alone is useless): WHIP (rover publish) requires the
		# internal secret; WHEP (browser play) requires rover operation access.
		@rtcwhip path /api/rtc/*/whip
		handle @rtcwhip {
			route {
				# Rover publish: reject anything without a VALID secret. The rover is on
				# the open internet, so this header (not a network boundary) is the auth.
				# Pass only when X-Internal-Service matches INTERNAL_SECRET, OR ROVER_SECRET
				# is configured (non-empty) AND X-Rover-Secret matches it. The `!= ""` guard
				# is essential: a plain `not header X-Rover-Secret {env.ROVER_SECRET}` matcher
				# with ROVER_SECRET unset (empty) MATCHES an empty inbound `X-Rover-Secret:`
				# header, letting an unauthenticated client publish (verified). Backward
				# compatible: ROVER_SECRET unset → only INTERNAL_SECRET is accepted.
				@noauth not expression `{http.request.header.X-Internal-Service} == {env.INTERNAL_SECRET} || ({env.ROVER_SECRET} != "" && {http.request.header.X-Rover-Secret} == {env.ROVER_SECRET})`
				respond @noauth 403
				request_header -Authuser
				request_header -X-Forwarded-For
				request_header -X-Internal-Service
				request_header -X-Rover-Secret
				uri strip_prefix /api/rtc
				reverse_proxy mediamtx:8889
			}
		}

		@rtcwhep path /api/rtc/*/whep
		handle @rtcwhep {
			route {
				request_header -Authuser
				request_header -X-Forwarded-For
				request_header -X-Internal-Service
				request_header -X-Rover-Secret
				# Browser play: require rover operation (JWT cookie validated by auth).
				forward_auth auth:9100 {
					uri /api/forward-auth?permission=rover.operate
					header_up X-Forward-Auth-Key {env.INTERNAL_SECRET}
				}
				uri strip_prefix /api/rtc
				reverse_proxy mediamtx:8889
			}
		}

		handle {
			request_header -X-Internal-Service
			request_header -X-Rover-Secret
			request_header -Authuser
			reverse_proxy course:10000
		}
	}

	# Score UI
	redir /score /score/
	handle /score/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Documents UI
	redir /documents /documents/
	handle /documents/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy competition:9200
	}

	# Calendar service
	redir /calendar /calendar/
	handle_path /calendar/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy calendar:11000
	}

	# FileBrowser service (proxy auth via forward_auth)
	redir /files /files/
	handle /files/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self'"
		request_header -X-Internal-Service
		request_header -Authuser
		# NOTE: X-Forwarded-User는 여기서 제거하지 않는다. handle 블록 안에서 Caddy는
		# 지시어를 작성 순서가 아닌 고정 directive order로 실행해 request_header가
		# forward_auth 뒤에 돌 수 있고, 그러면 copy_headers가 방금 설정한 헤더를 지워
		# FileBrowser 인증이 깨진다. 위조 인바운드 값은 forward_auth의 copy_headers가
		# 200 응답에서 Set(덮어쓰기)하고 비200은 리다이렉트되므로 이미 무력화된다.
		forward_auth auth:9100 {
			uri /api/forward-auth?permission=files.access
			header_up X-Forward-Auth-Key {env.INTERNAL_SECRET}
			copy_headers X-Forwarded-User
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /auth/api/login?redirect={http.request.uri}
			}
			@forbidden status 403
			handle_response @forbidden {
				redir * /
			}
		}
		reverse_proxy filebrowser:8080
	}

	# Energymeter service
	redir /energymeter /energymeter/
	handle_path /energymeter/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy energymeter:9800
	}

	# Email service
	redir /email /email/
	handle_path /email/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy email:9900
	}

	# Landing page (static files)
	handle {
		root * /srv/landing
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
