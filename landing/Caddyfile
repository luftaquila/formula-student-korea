:9000 {
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/wasm
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	# Auth service
	redir /auth /auth/
	handle_path /auth/* {
		request_header -X-Internal-Service
		request_header -Authuser
		request_header -X-Forwarded-Host
		reverse_proxy auth:9800
	}

	# Entry service
	redir /entry /entry/
	handle_path /entry/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy entry:9100
	}

	# Queue service
	redir /queue /queue/
	handle_path /queue/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy queue:9300
	}

	# Inspection service
	redir /inspection /inspection/
	handle_path /inspection/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy inspection:9600
	}

	# Traffic service
	redir /traffic /traffic/
	handle_path /traffic/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy traffic:9200
	}

	# Score service
	redir /score /score/
	handle_path /score/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy score:9700
	}

	# Documents service
	redir /documents /documents/
	handle_path /documents/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy documents:9900
	}

	# Energymeter service
	redir /energymeter /energymeter/
	handle_path /energymeter/* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy energymeter:9400
	}

	# Rules service (keeps /rules prefix - rules service handles it internally)
	handle /rules* {
		request_header -X-Internal-Service
		request_header -Authuser
		reverse_proxy rules:9500
	}

	# Landing page (static files)
	handle {
		root * /srv/landing
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
