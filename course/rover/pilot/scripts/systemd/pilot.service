[Unit]
Description=Pilot ROS2 Navigation System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=gpio
Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"

# Source ROS2 and workspace
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source ~/pilot_ws/install/setup.bash && INTERNAL_SECRET=${INTERNAL_SECRET} ros2 launch pilot pilot.launch.py server_url:=${SERVER_URL}"

# Restart on failure with 5 second delay
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# GPIO access
SupplementaryGroups=dialout gpio

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pilot

[Install]
WantedBy=multi-user.target
