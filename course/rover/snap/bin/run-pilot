#!/bin/sh
set -eu

get_conf() {
    if snapctl get "$1" >/dev/null 2>&1; then
        snapctl get "$1"
    else
        printf '%s' ""
    fi
}

SERVER_URL="$(get_conf server-url)"
INTERNAL_SECRET="$(get_conf internal-secret)"
ROS_DOMAIN_ID="$(get_conf ros-domain-id)"

# NTRIP caster host/port/password are compile-time constants in gps_node.py
# (NGII-only, shared "gnss" password). Only the per-operator username is
# configurable via snap.
NTRIP_USERNAME="$(get_conf ntrip-username)"

export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
# Secrets travel via env, never on the ROS2 param tree or the argv line.
export INTERNAL_SECRET
export NTRIP_USERNAME

# `ros2 launch` rejects `server_url:=` with an empty RHS, so on a fresh
# install (before the operator has run `snap set server-url=...`) we
# launch without the override and let bridge_node fall back to its
# config default. Without this guard the pilot daemon crash-loops until
# systemd gives up, and `snap services` shows it as failed for no
# obvious reason.
if [ -n "${SERVER_URL:-}" ]; then
    exec ros2 launch pilot pilot.launch.py \
        server_url:="${SERVER_URL}"
else
    exec ros2 launch pilot pilot.launch.py
fi
