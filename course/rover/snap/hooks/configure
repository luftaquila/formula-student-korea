#!/bin/sh
set -eu

NETPLAN=/etc/netplan/90-fsk-wifi.yaml

# Writing $NETPLAN and running `netplan apply` both require the
# network-setup-control plug. It is not auto-connected, so on a fresh
# install the hook must no-op rather than fail — a failing configure hook
# aborts the seed change and strands the device in install mode.
if ! snapctl is-connected network-setup-control 2>/dev/null; then
  echo "[configure] skipping Wi-Fi setup: run 'sudo snap connect ${SNAP_INSTANCE_NAME}:network-setup-control' to enable" >&2
  snapctl restart "$SNAP_INSTANCE_NAME.pilot" || true
  exit 0
fi

# Wi-Fi: snap-set values take precedence; defaults match the team's portable AP.
# Change at any time with:
#   sudo snap set fsk-rover-pilot wifi-ssid=<ssid> wifi-password=<pw>
#
# `snapctl get` on an unset key exits 0 with an empty string — the old
# `|| printf default` fallback never triggered, so `snap set server-url=…`
# (without any wifi-* key) wrote a netplan with SSID="" / password="".
# That is invalid YAML for wpa_supplicant, and netplan generate/apply
# then fails for the whole merged config, which wipes the ethernet
# configuration from the generated networkd units and leaves the rover
# with no IP at all after the next reboot. Guard on empty explicitly.
SSID=$(snapctl get wifi-ssid)
[ -n "$SSID" ] || SSID='default'
PASS=$(snapctl get wifi-password)
[ -n "$PASS" ] || PASS='password'

# Only emit the wifis block here. The ethernet path is handled by the
# snapd-provided `00-snapd-config.yaml` which matches `en*`/`eth*` globs
# — that covers Pi 5's `end0` automatically. Re-declaring eth0 here was
# both redundant and risky: any syntax error in this file takes down
# that whole merged netplan and strands ethernet along with Wi-Fi.
TMP=$(mktemp)
cat > "$TMP" <<EOF
network:
  version: 2
  renderer: networkd
  wifis:
    wlan0:
      dhcp4: true
      access-points:
        "${SSID}":
          password: "${PASS}"
EOF

# Only rewrite+apply on actual change to avoid yanking the link every refresh.
if ! cmp -s "$TMP" "$NETPLAN" 2>/dev/null; then
  install -m 600 "$TMP" "$NETPLAN"
  netplan apply || true
fi
rm -f "$TMP"

snapctl restart "$SNAP_INSTANCE_NAME.pilot" || true
