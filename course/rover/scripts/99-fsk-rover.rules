# FSK rover serial-port symlinks. Single source of truth — installed by
# pilot/scripts/setup_udev.sh on classic dev hosts and by the
# `setup-udev` step of scripts/provision-rover.sh on Ubuntu Core rovers.

# u-blox ZED-F9P GNSS receiver -> /dev/ttyGPS
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", \
    SYMLINK+="ttyGPS", MODE="0660", GROUP="dialout"

# RP2040-Zero coprocessor (Pico-SDK USB CDC) -> /dev/ttyMCU
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000a", \
    SYMLINK+="ttyMCU", MODE="0660", GROUP="dialout"
