[Unit]
Description=Restart pilot.service on USB plug/unplug
# Rate-limit our own start counter so a flapping cable (re-enumerating
# every ~3-4 s, outside the 2 s coalesce window) can't loop pilot.service
# indefinitely. After 5 starts in 60 s, systemd refuses further starts
# until the interval rolls over. The operator gets a clear journal
# entry instead of pilot ping-ponging.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
# Coalesce bursts: if the operator plugs in GPS and MCU within a
# couple of seconds, both udev events fire fsk-pilot-replug, but the
# second start is dropped while this oneshot is still in its sleep —
# so pilot is restarted once instead of twice.
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/systemctl restart pilot.service
