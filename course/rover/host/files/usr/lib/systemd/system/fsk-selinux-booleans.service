[Unit]
Description=FSK rover SELinux boolean overrides
# Policy needs to be loaded before setsebool can flip a boolean, and the
# runtime change has to land before pilot.service / perception.service start
# their run wrappers — without container_use_devices, the `--device` flags
# (ttyGPS/ttyMCU for pilot, /dev/video* for perception) fail at runtime under
# enforcing mode.
After=selinux-autorelabel-mark.service local-fs.target
Before=podman.socket pilot.service perception.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/setsebool container_use_devices on

[Install]
WantedBy=multi-user.target
