[Unit]
Description=FSK Rover Perception (camera streaming)
After=network-online.target podman.socket
Wants=network-online.target
# Camera comes and goes at runtime — fsk-perception-replug.service restarts
# this unit on USB plug/unplug so the wrapper re-probes /dev/video*.
# Rate-limit so a missing INTERNAL_SECRET / unplugged camera can't loop forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/perception-run
ExecStop=/usr/bin/podman stop -t 10 perception
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
