# syntax=docker/dockerfile:1

# Build stage - install all deps and build frontend
FROM node:22-alpine AS builder
ARG SERVICE
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache python3 make g++
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY ${SERVICE}/package.json ${SERVICE}/package.json
COPY ${SERVICE}/web/package.json ${SERVICE}/web/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "./${SERVICE}" --filter "./${SERVICE}/web"
COPY ${SERVICE}/index.mjs ${SERVICE}/index.mjs
COPY ${SERVICE}/web/ ${SERVICE}/web/
COPY ${SERVICE}/lib ${SERVICE}/lib
COPY shared shared
RUN pnpm --dir "${SERVICE}/web" run build
RUN pnpm --filter "./${SERVICE}" deploy --prod /prod/service

# Runtime stage - only production artifacts
FROM node:22-alpine
ARG SERVICE
ARG PORT
RUN apk add --no-cache su-exec
WORKDIR /home/node/fsk-${SERVICE}
COPY --from=builder /prod/service/node_modules node_modules/
COPY --from=builder /workspace/${SERVICE}/package.json ./
COPY --from=builder /workspace/${SERVICE}/index.mjs ./
COPY --from=builder /workspace/${SERVICE}/lib ./lib
COPY --from=builder /workspace/${SERVICE}/web/dist web/dist/
COPY shared ../shared
COPY entrypoint.sh /usr/local/bin/
ENV NODE_ENV=production
RUN mkdir -p data && chown -R node:node .
EXPOSE ${PORT}
ENTRYPOINT ["entrypoint.sh"]
CMD [ "node", "index.mjs" ]
