# Build stage - install all deps and build frontend
FROM node:22-alpine AS builder
ARG SERVICE
WORKDIR /build
COPY ${SERVICE}/package*.json ./
COPY ${SERVICE}/web/package*.json web/
RUN npm ci
RUN npm --prefix web ci --ignore-scripts
RUN node web/node_modules/esbuild/install.js
COPY ${SERVICE}/index.mjs ./
COPY ${SERVICE}/web/ web/
COPY ${SERVICE}/lib ./lib
COPY shared ../shared
RUN ln -s /build/web/node_modules /node_modules
RUN npm --prefix web run build

# Runtime stage - only production artifacts
FROM node:22-alpine
ARG SERVICE
ARG PORT
RUN apk add --no-cache su-exec
WORKDIR /home/node/fsk-${SERVICE}
COPY --from=builder /build/node_modules node_modules/
COPY --from=builder /build/package.json ./
COPY --from=builder /build/index.mjs ./
COPY --from=builder /build/lib ./lib
COPY --from=builder /build/web/dist web/dist/
COPY shared ../shared
COPY entrypoint.sh /usr/local/bin/
ENV NODE_ENV=production
RUN mkdir -p data && chown -R node:node .
EXPOSE ${PORT}
ENTRYPOINT ["entrypoint.sh"]
CMD [ "node", "index.mjs" ]
