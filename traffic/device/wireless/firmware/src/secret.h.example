/* LoRa pre-shared key — COPY this file to secret.h and replace the key.
 *
 *     cp secret.h.example secret.h     (in src/)
 *
 * secret.h is gitignored: the real key MUST NOT be committed. Every board in a
 * deployment (the master AND every sensor) must be flashed with the SAME 32-byte
 * key — boards with different keys cannot talk (every packet fails its MAC).
 *
 * Generate a fresh key with:
 *
 *     openssl rand -hex 32 | sed 's/\(..\)/0x\1,/g'
 *
 * and paste the 32 bytes below. The all-zero key here is a NON-SECRET
 * placeholder so dev/CI builds compile; it provides NO security. The build
 * prints a warning until you create src/secret.h with a real key.
 *
 * Rotating the key = reflash the whole fleet with a new secret.h.
 */
#ifndef SECRET_H
#define SECRET_H

/* Marks this file as the non-secret placeholder. A real key (your own secret.h)
 * must NOT define this — release builds (-DFLEET_KEY_REQUIRED) fail to compile
 * while it is present, so the all-zero key can never ship. */
#define LORA_PSK_PLACEHOLDER 1

#define LORA_PSK_BYTES \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

#endif /* SECRET_H */
